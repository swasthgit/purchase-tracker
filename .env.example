# ========================================
# FIREBASE CLIENT-SIDE CONFIGURATION
# ========================================
# Copy this file to .env.local and fill in your Firebase project details
# Get these values from: https://console.firebase.google.com/project/YOUR_PROJECT/settings/general
# Go to Project Settings > Your apps > Web app

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdefghijklmnop
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ========================================
# FIREBASE SERVER-SIDE CONFIGURATION (OPTIONAL)
# ========================================
# Only needed if you want to use Firebase Admin SDK for server-side operations
# Get these from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
#
# OPTION 1: Using environment variables (RECOMMENDED for production)
# Copy values from your serviceAccountKey.json file
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANB...your-private-key-here...\n-----END PRIVATE KEY-----\n"

# OPTION 2: Using JSON file path (easier for development)
# Place your serviceAccountKey.json in the config/ folder
# FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# ========================================
# APPLICATION CREDENTIALS
# ========================================
# Admin Panel Credentials
NEXT_PUBLIC_ADMIN_USERNAME=mswasth
NEXT_PUBLIC_ADMIN_PASSWORD=mswasth

# Inventory Admin Credentials
NEXT_PUBLIC_INVENTORY_ADMIN_USERNAME=tracker321
NEXT_PUBLIC_INVENTORY_ADMIN_PASSWORD=321tracker
